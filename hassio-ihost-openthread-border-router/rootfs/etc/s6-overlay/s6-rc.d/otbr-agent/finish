#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
#==============================================================================
# OpenThread BorderRouter Daemon finish script
#==============================================================================
if test "$1" -eq 256 ; then
  e=$((128 + $2))
else
  e="$1"
fi

finish_status=0
if test "$e" -ne 0; then
    bashio::log.warning "otbr-agent exited with code $e (by signal $2)."
    # Preserve the fatal result and tell s6 not to restart before any
    # best-effort teardown can consume its bounded cleanup window.
    finish_status=125
    printf '%s\n' "$e" > /run/s6-linux-init-container-results/exitcode
    /run/s6/basedir/bin/halt
else
    bashio::log.info "otbr-agent exited with code $e (by signal $2)."
fi

# shellcheck source=../../scripts/otbr-agent-common
# shellcheck disable=SC1091
. /etc/s6-overlay/scripts/otbr-agent-common

declare cleanup_claim_status
if otbr_firewall_cleanup_claim_consume; then
    if otbr_netfilter_cleanup; then
        bashio::log.info "OTBR firewall and NAT64 teardown completed."
    else
        bashio::log.warning "OTBR firewall or NAT64 teardown was incomplete."
    fi
else
    cleanup_claim_status=$?
    if (( cleanup_claim_status == 1 )); then
        bashio::log.info \
            "Skipping OTBR firewall and NAT64 teardown because startup did not claim the state."
    else
        bashio::log.warning \
            "Skipping OTBR firewall and NAT64 teardown because its ownership claim could not be consumed."
    fi
fi

if test "${finish_status}" -ne 0; then
    # Consider any otbr-agent exit as permanent failure according to s6
    exit "${finish_status}"
fi
