diff --git a/hassio-ihost-silabs-multiprotocol/tests/kernel/ip6tables-lock-probe b/hassio-ihost-silabs-multiprotocol/tests/kernel/ip6tables-lock-probe
new file mode 100644
index 0000000000000000000000000000000000000000..aeb7f86058c5ae8c11e235e75ad05b874196bda8
--- /dev/null
+++ b/hassio-ihost-silabs-multiprotocol/tests/kernel/ip6tables-lock-probe
@@ -0,0 +1,29 @@
+#!/bin/bash
+set -euo pipefail
+
+declare -a arguments=("$@")
+declare -i index
+declare wait_seconds=""
+
+for ((index = 0; index < ${#arguments[@]}; index++)); do
+    case "${arguments[index]}" in
+        -w)
+            (( index + 1 < ${#arguments[@]} )) || exit 2
+            wait_seconds="${arguments[index + 1]}"
+            break
+            ;;
+        -w[0-9]*)
+            wait_seconds="${arguments[index]#-w}"
+            break
+            ;;
+    esac
+done
+
+[[ "${wait_seconds}" =~ ^[0-9]+$ ]] || exit 2
+: "${XTABLES_LOCKFILE:?XTABLES_LOCKFILE must name the probe lock}"
+
+# Execute in place so GNU timeout cannot leave a waiter behind. The real
+# ip6tables command uses its default lock after this deterministic probe lock.
+exec flock --exclusive --no-fork --timeout "${wait_seconds}" \
+    "${XTABLES_LOCKFILE}" env -u XTABLES_LOCKFILE \
+    /usr/sbin/ip6tables "$@"
