new file mode 100644
index 0000000000000000000000000000000000000000..af3845a962a81221d57bad9b7d7b0f02ed86cad0
--- /dev/null
+++ b/hassio-ihost-silabs-multiprotocol/tests/readiness/listener-run
@@ -0,0 +1,5 @@
+#!/bin/sh
+# Deterministic version of the released service's pre-listener flushing window.
+while [ ! -e /fixture/listen ]; do sleep 0.1; done
+# A connection would create a marker, making an invasive healthcheck fail tests.
+exec socat "TCP-LISTEN:$(cat /fixture/port),reuseaddr,fork" 'EXEC:touch /fixture/accepted'
diff --git a/hassio-ihost-silabs-multiprotocol/tests/test-zigbeed-readiness.sh b/hassio-ihost-silabs-multiprotocol/tests/test-zigbeed-readiness.sh
