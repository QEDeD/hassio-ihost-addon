@@ -0,0 +1,49 @@
+name: Local commissioning QR
+
+on:
+  pull_request:
+    paths:
+      - 'hassio-ihost-silabs-multiprotocol/Dockerfile'
+      - 'hassio-ihost-silabs-multiprotocol/otbr-patches/**'
+      - 'tests/qr/**'
+      - '.github/workflows/local-commissioning-qr.yml'
+  push:
+    paths:
+      - 'hassio-ihost-silabs-multiprotocol/Dockerfile'
+      - 'hassio-ihost-silabs-multiprotocol/otbr-patches/**'
+      - 'tests/qr/**'
+      - '.github/workflows/local-commissioning-qr.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  frontend:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0
+        with:
+          persist-credentials: false
+      - name: Build and install pinned frontend; check controller
+        run: python3 tests/qr/prepare.py "$RUNNER_TEMP/qr-frontend"
+      - name: Install browser test tools
+        run: npm --prefix "$RUNNER_TEMP/qr-tools" install --ignore-scripts --no-audit --no-fund @playwright/cli@0.1.19 jsqr@1.4.0
+      - name: Check rendered QR dialogs with synthetic data
+        shell: bash
+        run: |
+          set -euo pipefail
+          cli="$RUNNER_TEMP/qr-tools/node_modules/.bin/playwright-cli"
+          node tests/qr/serve.cjs \
+            "$RUNNER_TEMP/qr-frontend/install/share/otbr-web/frontend" \
+            "$RUNNER_TEMP/qr-tools/node_modules/jsqr/dist/jsQR.js" &
+          server_pid=$!
+          trap '"$cli" -s=qr-ci close || true; kill "$server_pid" || true' EXIT
+          for attempt in {1..30}; do
+            if curl --fail --silent http://127.0.0.1:18764/ >/dev/null; then break; fi
+            sleep 1
+          done
+          curl --fail --silent http://127.0.0.1:18764/ >/dev/null
+          "$cli" -s=qr-ci open http://127.0.0.1:18764 --browser chrome
+          "$cli" -s=qr-ci run-code --filename tests/qr/browser-check.js
