#!/usr/bin/with-contenv bashio
# Key preflight can fail before CPCd creates its shared-memory directory.
# Cleanup must never prevent a failed service from stopping the container.
bashio::log.info "CPC ended with exit code ${1} (signal ${2})..."
if ! rm -rf -- /dev/shm/cpcd; then
    bashio::log.warning "Unable to clean CPC shared-memory directory"
fi
if [ "${1}" -ne 0 ] && [ "${1}" -ne 256 ]; then
    /run/s6/basedir/bin/halt
    # Mark startup failure permanent so readiness waiters can fail and halt can finish.
    exit 125
fi
