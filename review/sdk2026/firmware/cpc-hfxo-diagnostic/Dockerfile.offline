FROM --platform=linux/amd64 ghcr.io/nabucasa/silabs-firmware-builder@sha256:aaeedf3cceb95dc15a9d3333093e76957ef20d06f94d3f7b23d5bd88d337a85d AS build
USER root
ENV DEBIAN_FRONTEND=noninteractive
COPY review/sdk2026/recipe/pin-debian-snapshot.sh /pin-debian-snapshot.sh
RUN sh /pin-debian-snapshot.sh && apt-get update && apt-get install -y --no-install-recommends cmake ninja-build python3 gzip patch \
    && mkdir -p /package-evidence && dpkg-query -W > /package-evidence/installed-packages.txt \
    && cp /etc/apt/sources.list.d/debian.sources /package-evidence/debian.sources \
    && sha256sum /var/lib/apt/lists/*InRelease > /package-evidence/inrelease-sha256.txt \
    && rm -rf /var/lib/apt/lists/*
COPY review/sdk2026/firmware/cpc-recovery/build-offline.sh /firmware/base-build-offline.sh
COPY review/sdk2026/firmware/cpc-recovery/explicit-unbind-only.patch /firmware/explicit-unbind-only.patch
COPY review/sdk2026/firmware/cpc-recovery/explicit-uart.slcp.patch /firmware/explicit-uart.slcp.patch
COPY review/sdk2026/firmware/cpc-recovery/verify-offline.sh /firmware/verify-offline.sh
COPY review/sdk2026/firmware/cpc-hfxo-diagnostic/prepare-build.py /firmware/prepare-build.py
ARG BUILD_JOBS=2
RUN --network=none python3 /firmware/prepare-build.py /firmware/base-build-offline.sh /firmware/build-offline.sh \
    && JOBS="$BUILD_JOBS" bash /firmware/build-offline.sh \
    && WORK=/sdk2026-cpc-recovery bash /firmware/verify-offline.sh \
    && grep -Eq '^#define SL_CLOCK_MANAGER_HFXO_EN +1$' /sdk2026-cpc-recovery/generated/config/sl_clock_manager_oscillator_config.h \
    && cp -a /package-evidence /sdk2026-cpc-recovery/evidence/ \
    && cp /firmware/* /sdk2026-cpc-recovery/evidence/
FROM scratch AS artifacts
COPY --from=build /sdk2026-cpc-recovery/source /source
COPY --from=build /sdk2026-cpc-recovery/generated/config /config
COPY --from=build /sdk2026-cpc-recovery/generated/autogen /autogen
COPY --from=build /sdk2026-cpc-recovery/generated/cmake_gcc/build/base /artifacts
COPY --from=build /sdk2026-cpc-recovery/evidence /evidence
