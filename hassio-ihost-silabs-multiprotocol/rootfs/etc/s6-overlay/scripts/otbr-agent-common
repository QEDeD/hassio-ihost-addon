#!/bin/bash
# shellcheck shell=bash

thread_if="wpan0"
otbr_forward_ingress_chain="OTBR_FORWARD_INGRESS"
otbr_forward_egress_chain="OTBR_FORWARD_EGRESS"
otbr_firewall_ipsets=(
    "otbr-ingress-deny-src"
    "otbr-ingress-deny-src-swap"
    "otbr-ingress-allow-dst"
    "otbr-ingress-allow-dst-swap"
)

otbr_iptables_wait_seconds=5
otbr_cleanup_max_rule_deletes=64
otbr_ipset_destroy_attempts=20
otbr_ipset_destroy_delay_seconds=0.1

_otbr_remove_forward_jumps()
{
    local interface_flag="$1"
    local chain_name="$2"
    local removed=0

    while (( removed < otbr_cleanup_max_rule_deletes )); do
        if ! ip6tables -w "${otbr_iptables_wait_seconds}" \
            -C FORWARD "${interface_flag}" "${thread_if}" \
            -j "${chain_name}" 2>/dev/null; then
            return 0
        fi

        if ! ip6tables -w "${otbr_iptables_wait_seconds}" \
            -D FORWARD "${interface_flag}" "${thread_if}" \
            -j "${chain_name}"; then
            return 1
        fi

        removed=$((removed + 1))
    done

    # Refuse to loop indefinitely if state is unexpectedly duplicated many times.
    if ip6tables -w "${otbr_iptables_wait_seconds}" \
        -C FORWARD "${interface_flag}" "${thread_if}" \
        -j "${chain_name}" 2>/dev/null; then
        return 1
    fi

    return 0
}

_otbr_delete_chain_if_exist()
{
    local chain_name="$1"
    local failed=0

    if ! ip6tables -w "${otbr_iptables_wait_seconds}" \
        -L "${chain_name}" -n >/dev/null 2>&1; then
        return 0
    fi

    if ! ip6tables -w "${otbr_iptables_wait_seconds}" \
        -F "${chain_name}"; then
        failed=1
    fi

    if ! ip6tables -w "${otbr_iptables_wait_seconds}" \
        -X "${chain_name}"; then
        failed=1
    fi

    return "${failed}"
}

_otbr_ipset_destroy_if_exist()
{
    local ipset_name="$1"
    local attempt=1

    while (( attempt <= otbr_ipset_destroy_attempts )); do
        if ! ipset list -n "${ipset_name}" >/dev/null 2>&1; then
            return 0
        fi

        if ipset destroy "${ipset_name}" >/dev/null 2>&1; then
            return 0
        fi

        if (( attempt < otbr_ipset_destroy_attempts )); then
            sleep "${otbr_ipset_destroy_delay_seconds}"
        fi

        attempt=$((attempt + 1))
    done

    return 1
}

otbr_firewall_setup()
{
    local firewall_enabled="$1"

    if [[ "${firewall_enabled}" == "true" ]]; then
        ipset create -exist otbr-ingress-deny-src hash:net family inet6
        ipset create -exist otbr-ingress-deny-src-swap hash:net family inet6
        ipset create -exist otbr-ingress-allow-dst hash:net family inet6
        ipset create -exist otbr-ingress-allow-dst-swap hash:net family inet6

        ip6tables -N "${otbr_forward_ingress_chain}"
        ip6tables -I FORWARD 1 -o "${thread_if}" -j "${otbr_forward_ingress_chain}"

        ip6tables -A "${otbr_forward_ingress_chain}" -m pkttype --pkt-type unicast -i "${thread_if}" -j DROP
        ip6tables -A "${otbr_forward_ingress_chain}" -m set --match-set otbr-ingress-deny-src src -j DROP
        ip6tables -A "${otbr_forward_ingress_chain}" -m set --match-set otbr-ingress-allow-dst dst -j ACCEPT
        ip6tables -A "${otbr_forward_ingress_chain}" -m pkttype --pkt-type unicast -j DROP
        ip6tables -A "${otbr_forward_ingress_chain}" -j ACCEPT

        ip6tables -N "${otbr_forward_egress_chain}"
        ip6tables -I FORWARD 2 -i "${thread_if}" -j "${otbr_forward_egress_chain}"
        ip6tables -A "${otbr_forward_egress_chain}" -j ACCEPT
    elif [[ "${firewall_enabled}" == "false" ]]; then
        # Make sure ip6tables (as used by Docker) allows IP forwarding.
        ip6tables -P FORWARD ACCEPT
        # HAOS 9.3 and earlier (for 9.4 ACCEPT is the default, so this does nothing).
        ip6tables-legacy -P FORWARD ACCEPT
    else
        return 2
    fi
}

otbr_firewall_cleanup()
{
    local ipset_name
    local failed=0

    if ! _otbr_remove_forward_jumps -o "${otbr_forward_ingress_chain}"; then
        failed=1
    fi

    if ! _otbr_remove_forward_jumps -i "${otbr_forward_egress_chain}"; then
        failed=1
    fi

    if ! _otbr_delete_chain_if_exist "${otbr_forward_ingress_chain}"; then
        failed=1
    fi

    if ! _otbr_delete_chain_if_exist "${otbr_forward_egress_chain}"; then
        failed=1
    fi

    for ipset_name in "${otbr_firewall_ipsets[@]}"; do
        if ! _otbr_ipset_destroy_if_exist "${ipset_name}"; then
            failed=1
        fi
    done

    return "${failed}"
}
