#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# OpenThread BorderRouter start script
# ==============================================================================

# shellcheck source=../../scripts/otbr-agent-common
# shellcheck disable=SC1091
. /etc/s6-overlay/scripts/otbr-agent-common

if ! otbr_firewall_cleanup_claim_reset; then
    bashio::exit.nok "Could not reset the OTBR firewall ownership claim."
fi

if ! otbr_firewall_cleanup_is_safe; then
    bashio::exit.nok \
        "Refusing to reconcile OTBR firewall state: ${otbr_cleanup_guard_reason}."
fi

if ! otbr_firewall_cleanup_claim_create; then
    bashio::exit.nok "Could not create the OTBR firewall ownership claim."
fi

if ! otbr_firewall_cleanup; then
    bashio::exit.nok "Could not clean up stale OTBR firewall state."
fi

declare backbone_if
declare network_info
# shellcheck disable=SC2034
declare device
# shellcheck disable=SC2034
declare baudrate
# shellcheck disable=SC2034
declare flow_control
declare otbr_log_level
declare otbr_log_level_int
declare otbr_rest_listen
declare otbr_rest_listen_port

# Fetch raw JSON: Bashio's filtered API helper can return success after jq fails.
if ! network_info="$(bashio::api.supervisor 'GET' '/network/info' true)"; then
    bashio::exit.nok "Could not retrieve Supervisor network information."
fi
if ! backbone_if="$(jq --slurp --exit-status --raw-output '
    if length != 1 then error("Expected one network response") else .[0] end
    | if .result != "ok" or (.data.interfaces | type) != "array" then
        error("Invalid network response")
      else .data.interfaces end
    | if all(.[]; type == "object"
        and (.primary | type) == "boolean"
        and (.interface | type) == "string"
        and (.interface | length) > 0) then
        (first(.[] | select(.primary == true)) | .interface) // ""
      else error("Invalid network interface") end
' <<< "${network_info}")"; then
    bashio::exit.nok "Invalid Supervisor network information."
fi

otbr_log_level=$(bashio::string.lower "$(bashio::config otbr_log_level)")
case "${otbr_log_level}" in
    debug)
        otbr_log_level_int="7"
        ;;
    info)
        otbr_log_level_int="6"
        ;;
    notice)
        otbr_log_level_int="5"
        ;;
    warning)
        otbr_log_level_int="4"
        ;;
    error)
        otbr_log_level_int="3"
        ;;
    critical)
        otbr_log_level_int="2"
        ;;
    alert)
        otbr_log_level_int="1"
        ;;
    emergency)
        otbr_log_level_int="0"
        ;;
    *)
        bashio::exit.nok "Unknown otbr_log_level: ${otbr_log_level}"
        ;;
esac

# shellcheck disable=SC2086
if [ -z ${backbone_if} ]; then
    bashio::log.warning "No primary network interface found! Using static eth0."
    backbone_if="eth0"
fi

# shellcheck disable=SC2015
mkdir -p /data/thread && ln -sft /var/lib /data/thread || bashio::exit.nok "Could not create directory /var/lib/thread to store Thread data."

firewall_enabled=false
if bashio::config.true 'otbr_firewall'; then
    firewall_enabled=true
    bashio::log.info "Setting up OTBR ingress filtering."
else
    bashio::log.info "OTBR ingress filtering is disabled; allowing scoped Thread forwarding."
fi

if ! otbr_firewall_setup "${firewall_enabled}"; then
    bashio::exit.nok "Could not set up OTBR firewall state."
fi
if bashio::config.true 'otbr_nat64'; then
    if ! otbr_nat64_setup "${backbone_if}"; then
        bashio::exit.nok "Could not reserve the NAT64 pool or set up scoped IPv4 forwarding."
    fi
fi

otbr_rest_listen="::"
otbr_rest_listen_port="$(bashio::addon.port 8081)"

# If user port is not set, listen on local interface only
if ! bashio::var.has_value "${otbr_rest_listen_port}"; then
    otbr_rest_listen="$(bashio::addon.ip_address)"
    otbr_rest_listen_port="8081"
elif [ "${otbr_rest_listen_port}" != "8081" ]; then
    bashio::log.warning "Custom OpenThread REST API port is not supported. Using 8081."
    otbr_rest_listen_port="8081"
fi

# Store REST API listen information for check script
echo "${otbr_rest_listen}" > /tmp/otbr-agent-rest-api
echo "${otbr_rest_listen_port}" >> /tmp/otbr-agent-rest-api

bashio::log.info "Starting otbr-agent..."
# shellcheck disable=SC2086
exec s6-notifyoncheck -d -s 300 -w 300 -n 0 \
    "/usr/sbin/otbr-agent" -I ${thread_if} -B "${backbone_if}" \
        --rest-listen-address "${otbr_rest_listen}" \
        -d${otbr_log_level_int} -v \
        "spinel+cpc://cpcd_0?iid=2&iid-list=0"
