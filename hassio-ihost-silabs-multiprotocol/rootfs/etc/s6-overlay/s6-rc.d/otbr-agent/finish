#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
#==============================================================================
# OpenThread BorderRouter Daemon finish script
#==============================================================================
if test "$1" -eq 256 ; then
    e=$((128 + $2))
else
    e="$1"
fi

fatal_exit=false
if test "$e" -ne 0; then
    # Persist the service result and initiate container shutdown before
    # best-effort teardown. s6 may SIGKILL an overdue finish script.
    echo "$e" > /run/s6-linux-init-container-results/exitcode
    /run/s6/basedir/bin/halt
    fatal_exit=true
    bashio::log.warning "otbr-agent exited with code $e (by signal $2)."
else
    bashio::log.info "otbr-agent exited with code $e (by signal $2)."
fi

# shellcheck source=../../scripts/otbr-agent-common
# shellcheck disable=SC1091
. /etc/s6-overlay/scripts/otbr-agent-common

declare cleanup_claim_status
if otbr_firewall_cleanup_claim_consume; then
    if otbr_firewall_cleanup; then
        bashio::log.info "OTBR firewall teardown completed."
    else
        bashio::log.warning "OTBR firewall teardown was incomplete."
    fi
else
    cleanup_claim_status=$?
    if (( cleanup_claim_status == 1 )); then
        bashio::log.info \
            "Skipping OTBR firewall teardown because startup did not claim the firewall state."
    else
        bashio::log.warning \
            "Skipping OTBR firewall teardown because its ownership claim could not be consumed."
    fi
fi

if [[ "${fatal_exit}" == "true" ]]; then
    # Prevent a restart if shutdown has not completed by the time teardown
    # returns. The shutdown request above protects this decision if teardown
    # itself reaches timeout-finish.
    exit 125
fi
